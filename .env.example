# Copy to .env and adjust. Every value below is optional: the code falls back
# to the defaults baked into configs/*.yaml and src/config.py.

# Root of the DeepCrack dataset (must contain train_img/ train_lab/ test_img/ test_lab/)
DATA_DIR=../_datasets/deep_crack_dataset

# Checkpoint loaded by evaluate.py, predict.py and the Flask app. When unset,
# checkpoints/best.pt is used if it exists, otherwise the bundled CPU demo model
# checkpoints/demo/unet_cpu_demo.pt.
# CHECKPOINT_PATH=checkpoints/best.pt

# YAML config used when a CLI does not pass --config
CONFIG_PATH=configs/unet.yaml

# torch device: cuda | cpu | mps | auto
DEVICE=auto

# DataLoader workers. Use 0 on Windows if you hit spawn/pickling problems.
NUM_WORKERS=4

# Global seed for python / numpy / torch
RANDOM_SEED=42

# Maximum accepted upload size for the web UI, in megabytes
MAX_UPLOAD_MB=16

# Flask environment: development | production
FLASK_ENV=development

# Flask session signing key. Generate one for any real deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
